# 부팅 때마다 pi/pi.py 를 켠다. install.sh 가 /etc/systemd/system/ 에 복사한다 (경로 · 사용자는 그때 맞춘다)
[Unit]
Description=GreenTwin (pi/pi.py)
After=network-online.target
Wants=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/greentwin
EnvironmentFile=/home/pi/greentwin/pi/pi.env
ExecStart=/usr/bin/python3 /home/pi/greentwin/pi/pi.py
# 프로그램이 어떻게 끝나든 릴레이(조명 12 · 팬 5 · 펌프 17) 핀을 띄워서 끈다
ExecStopPost=-+/usr/bin/pinctrl set 5,12,17 ip pn
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
