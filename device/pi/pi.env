# 라즈베리파이 설정 (pi/pi.py 가 읽는다). 바꾼 뒤: sudo systemctl restart greentwin
# 주의: 값 뒤에 설명을 붙여 쓰면 안 된다 (설명은 이렇게 따로 한 줄로)

# 1 = 회전판 · 릴레이 · 온습도 · 아래 카메라,  2 = 가운데 카메라만  (install.sh 가 넣는다)
PI=1

# 온습도 센서: dht (DHT11 · DHT22) | cmd (아래 명령을 불러서 읽는다) | none
SENSOR=dht
# SENSOR=cmd 일 때: {"temp_c": 23.4, "rh_pct": 61} 한 줄을 찍는 명령.  예) python3 /home/pi/read.py
SENSOR_CMD=

# 릴레이가 켜지는 레벨. 0 = LOW 에 켜지는 모듈(기본). 켜고 끄는 것이 반대로 되면 1
RELAY_ON=0
# 원점 센서가 자석 위에서 내는 레벨. 자석이 있는데도 원점을 못 찾으면 1
HOME_ON=0
# 회전 방향. 회전판은 위에서 내려다볼 때 반시계 방향으로 돌아야 한다 (카메라 쪽 면이 카메라의 오른쪽으로 간다).
# 시계 방향으로 돌면 -1 (그대로 두면 3D 가 뭉개진다)
TURN_DIR=1

# "덥고 건조하면(30 °C 이상 · 40 % 이하) 물 한 번 더". 급수 시점은 서버의 급수 예측(hub)이 정하므로 기본은 끔(0).
# 서버 없이 혼자 돌릴 때만 1
DRY_EXTRA=0

# 팀 서버 (server/ 의 FastAPI). Pi ① 이 기록 · 스캔을 올리고, 대시보드 명령을 10초마다 받아 온다 (비우면 서버 없이 혼자 돈다)
# 토큰은 db/token 파일에 한 줄로 (server/.env 의 DEVICE_UPLOAD_TOKEN 과 같은 값). 서버는 uvicorn ... --host 0.0.0.0 으로 켠다
# Pi ① 과 서버가 같은 Wi-Fi(핫스팟)에 있어야 한다. 서버 노트북의 주소가 바뀌면 여기와 MQTT_HOST 만 고친다
DB_URL=http://172.20.10.5:8000
# DB 에서 이 화분의 번호 (plant 표의 id)
PLANT_ID=1

# 온습도는 MQTT 로 (server/mqtt_subscriber.py 가 받아 DB 에 넣는다). 비우면 HTTP 로 바로 올린다
MQTT_HOST=172.20.10.5
MQTT_PORT=1884
MQTT_TOPIC=smartfarm/sensor/environment
