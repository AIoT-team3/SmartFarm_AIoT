# 맥북 설정 — 맥북에서 부르는 .sh 가 모두 이 파일을 읽는다
# (Pi 이름이 gt-pi1 · gt-pi2 가 아니면 주소를 고친다. Pi ① 에 설치하면 그 Pi 안의 이 파일은 PI1=http://localhost:8765 로 바뀐다)
PI1=http://gt-pi1.local:8765     # Pi ① : 회전판 · 릴레이(조명 · 팬 · 펌프) · 온습도 · 아래 카메라
PI2=http://gt-pi2.local:8765     # Pi ② : 가운데 카메라
PLANT=greenonion                 # 키우는 식물: greenonion(파) · basil(바질) — 예측이 처음에 믿는 값이 달라진다
SOWN=2026-11-01                  # 심은 날 (파 밑동을 꽂은 날 · 파종일) — '며칠째'와 예측의 기준
TARGET_CM=24                     # 수확할 키 (흙 위 cm). 카메라가 잴 수 있는 높이(약 26 cm)보다 낮게
DATA=data                        # 결과 파일을 두는 폴더
ROTATE=90                        # 카메라를 세로로 달았을 때 사진을 세우는 각도 (거꾸로 나오면 270)
SCAN_AT=08:00,13:00,18:00        # Pi ① 이 혼자 스캔 → 예측 → 상태 정리를 하는 시각 (바꾼 뒤 Pi ① 에서 bash pi/install.sh 1)
GREEN=0.05                       # 식물로 보는 초록 정도 (배경이 섞이면 올리고, 잎이 빠지면 내린다)
WATER_THRESHOLD=1000             # 급수가 필요한 VPD 누적 (kPa·min). 흙이 마른 시각의 누적값을 보고 고친다 — docs/watering-forecast-design.md
WATER_ML=25                      # 한 번 급수량 (mL)
